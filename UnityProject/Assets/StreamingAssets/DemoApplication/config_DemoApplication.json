      // a file that stores the preoperative registration landmarks (must be in the registration folder)
      "fileName": "evdRegistrationPoints.txt",
      // control the visualization of spheres showing the picked intraoperative landmarks 
      "material": "transparent",
      "color": "00FF00",
      "sphereRadious": 0.0020000000949949028,
      // if the file contain many points (lines of 3d coordinates), we can use a subset of them, if false we use all landmarks in the file
